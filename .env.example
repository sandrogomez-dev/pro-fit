# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# App-side (Expo). These are PUBLIC by design — they ship in the client bundle and
# are protected by Supabase Row Level Security, not by secrecy. Must be prefixed
# EXPO_PUBLIC_ to be readable from the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side ONLY. Do NOT put these in this app's .env — they live as Supabase
# Edge Function secrets, set via `supabase secrets set DEEPSEEK_API_KEY=...`.
# Listed here only as documentation of the contract.
# DEEPSEEK_API_KEY=
